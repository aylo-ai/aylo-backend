# Never bake secrets or local state into the image — the runtime env comes from
# compose's env_file, and COPY . /app would otherwise ship .env inside the layer.
.env
.env.*
*.pem
*.key

# Service-account keys. A Google private key was committed under
# apps/shared/addons/ and `COPY . /app` baked it into every image built from
# this tree. Mount credentials at runtime instead — see
# GOOGLE_SERVICE_ACCOUNT_FILE.
secrets/
*-cred.json
*service-account*.json
*credentials*.json

.git
.github
.venv
venv

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

media/
staticfiles/
celerybeat-schedule
*.sqlite3
*.log
*.xlsx

docs/
.claude/
.idea/
.vscode/
