# Copy to .env and fill in. Never commit .env — only this file.

# --- Core ---
DEBUG=True
SECRET_KEY=
# Public origin of this API; used to build OAuth redirect URIs.
BASE_URL=https://api.aylo.uz

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- OpenAI ---
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
GOOGLE_GEMINI_API_KEY=

# --- Instagram / Meta ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
# Required for webhook signature verification — an unset APP_SECRET makes the
# webhook fail closed and reject every delivery.
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# --- amoCRM OAuth (required when DEBUG=False) ---
AMOCRM_CLIENT_ID=
AMOCRM_SECRET_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Payments ---
PAYME_ID=
PAYME_KEY=
PAYME_API_URL=https://checkout.paycom.uz/api

# --- Email (Zoho SMTP) ---
# Set to django.core.mail.backends.console.EmailBackend locally to print OTPs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- SMS (Play Mobile) ---
SEND_SMS=False
PLAY_MOBILE_URL=
PLAY_MOBILE_LOGIN=
PLAY_MOBILE_PASSWORD=
PLAY_MOBILE_ORIGINATOR=

# --- Google (Docs / Sheets knowledge-base import) ---
# Path to the service-account JSON *inside the container*. Mount it as a secret;
# never commit it. The previous key lived in the repo at
# apps/shared/addons/repli-ai-cred.json and must be revoked in GCP.
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json

# --- Object storage (MinIO) ---
# Root credential. Stays inside the minio container: it is NOT the credential
# the app uses. Generate with `openssl rand -hex 24`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Admin console. Leave off in production — it is an admin surface and nginx
# does not proxy it. Set to `on` and tunnel to 127.0.0.1:9001 when you need it.
MINIO_BROWSER=off

# The credential Django uses. deployment/minio/init.sh creates this user and
# attaches a policy limited to MINIO_BUCKET_NAME — it cannot touch other
# buckets or the admin API. Generate both with `openssl rand -hex 24`.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=aylo-media

# Internal S3 endpoint Django and the Celery workers use for reads and writes.
# Inside compose this is the service name; for a local runserver on the host it
# is http://127.0.0.1:9000.
MINIO_ENDPOINT_URL=http://minio:9000
# Endpoint the bootstrap container uses. Separate from the above on purpose: the
# init container always runs inside the compose network, even when Django is on
# the host and points at 127.0.0.1.
MINIO_INTERNAL_ENDPOINT=http://minio:9000
# Public ORIGIN browsers resolve presigned URLs against — scheme + host only,
# no path. A SigV4 signature covers the host and the full path, so if nginx
# rewrites or strips any prefix the signature no longer matches and MinIO
# returns 403 on every link. nginx must proxy `/<bucket>/` through untouched.
MINIO_PUBLIC_URL=https://api.aylo.uz
# Lifetime of a presigned URL, in seconds. Short is safer; long is cacheable.
MINIO_URL_EXPIRY=3600
# `on` keeps overwritten/deleted objects recoverable, at the cost of disk.
MINIO_VERSIONING=off

# --- AWS S3 (legacy — migration source only) ---
# Kept solely so `manage.py migrate_media_to_minio` can read the old bucket.
# Delete these once the migration has been verified.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Error reporting ---
ERROR_TELEGRAM_BOT_TOKEN=
ERROR_TELEGRAM_CHAT_ID=
