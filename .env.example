# Copy to .env and fill in. Never commit .env — only this file.

# --- Core ---
DEBUG=True
SECRET_KEY=
# Public origin of this API; used to build OAuth redirect URIs.
BASE_URL=https://api.aylo.uz

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- OpenAI ---
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
GOOGLE_GEMINI_API_KEY=

# --- Instagram / Meta ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
# Required for webhook signature verification — an unset APP_SECRET makes the
# webhook fail closed and reject every delivery.
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# --- amoCRM OAuth (required when DEBUG=False) ---
AMOCRM_CLIENT_ID=
AMOCRM_SECRET_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Payments ---
PAYME_ID=
PAYME_KEY=
PAYME_API_URL=https://checkout.paycom.uz/api

# --- Email (Zoho SMTP) ---
# Set to django.core.mail.backends.console.EmailBackend locally to print OTPs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- SMS (Play Mobile) ---
SEND_SMS=False
PLAY_MOBILE_URL=
PLAY_MOBILE_LOGIN=
PLAY_MOBILE_PASSWORD=
PLAY_MOBILE_ORIGINATOR=

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# --- Error reporting ---
ERROR_TELEGRAM_BOT_TOKEN=
ERROR_TELEGRAM_CHAT_ID=
